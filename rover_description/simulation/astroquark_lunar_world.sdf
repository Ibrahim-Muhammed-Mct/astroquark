<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.11">
  <world name="astroquark_world">
    <gravity>0 0 -1.62</gravity>
    <physics name="lunar_surface" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />


    <!-- Initial camera: above the near side, looking across the whole course. -->
    <gui>
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.25 0.25 0.28</ambient_light>
        <background_color>0.018 0.020 0.027</background_color>
        <camera_pose>-1.4 -6.5 4.25 0 0.472 0.990</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="string" key="state">floating</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
    </gui>

    <scene>
      <ambient>0.25 0.25 0.28 1</ambient>
      <background>0.018 0.020 0.027 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light name="sun" type="directional">
      <direction>-0.54 0.48 -0.60</direction>
      <diffuse>0.91 0.89 0.85 1</diffuse>
      <specular>0.12 0.12 0.14 1</specular>
      <cast_shadows>true</cast_shadows>
    </light>

    <model name="lunar_ground">
      <static>true</static>
      <link name="surface">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.34 0.33 0.32 1</ambient>
            <diffuse>0.47 0.45 0.43 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The top face rises by 0.348 m at 8 degrees, from x=1.65 to x=4.126. -->
    <model name="lunar_ramp">
      <static>true</static>
      <pose>2.900360665 0 0.084842250 0 -0.139626340 0</pose>
      <link name="ramp">
        <collision name="ramp_collision">
          <geometry><box><size>2.5 2.35 0.18</size></box></geometry>
        </collision>
        <visual name="ramp_visual">
          <geometry><box><size>2.5 2.35 0.18</size></box></geometry>
          <material>
            <ambient>0.43 0.41 0.37 1</ambient>
            <diffuse>0.52 0.49 0.46 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="observation_plateau">
      <static>true</static>
      <pose>5.625670172 0 0.173966376 0 0 0</pose>
      <link name="plateau">
